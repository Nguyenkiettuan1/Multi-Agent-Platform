# =============================================================================
# Multi-Agent Platform — .env
# Copy:  copy .env.example .env
# Hướng dẫn đầy đủ: docs/12-LOCAL-SETUP.md
#   - Cách A: Docker (docker compose up -d)
#   - Cách B: Cài tay PostgreSQL 16 + pgvector + pgAdmin
# =============================================================================

# --- PostgreSQL (Docker: user=phanlaw, password=phanlaw, db=phanlaw) ---

# App schema — DB worker đọc (user read-only agent_reader)
# Port 5434 = Docker postgres (5432=PG native, 5433=postgres_db cũ)
DATABASE_URL=postgresql+psycopg://agent_reader:agent_reader_local@localhost:5434/multiagent?options=-csearch_path%3Dapp

# Platform schema — LangGraph checkpoints, feedback, audit
PLATFORM_DATABASE_URL=postgresql+psycopg://multiagent:multiagent@localhost:5434/multiagent?options=-csearch_path%3Dplatform

# Admin — CHỈ cho scripts/db_migrate.py, seed.py (user phanlaw)
MIGRATE_DATABASE_URL=postgresql+psycopg://multiagent:multiagent@localhost:5434/multiagent

# --- Redis (Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- Gateway API (chạy trên máy) ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
APP_ENV=local

# --- LLM (tùy chọn — không có vẫn chạy rule-based) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Azure OpenAI / AI Foundry — khớp deployment trên portal (cognitiveservices.azure.com)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview
# Chat: deployment name = model_id trong config/models.yaml (gpt-4o-mini, gpt-4.1)
# Embeddings: dùng EMBEDDING_DEPLOYMENT bên dưới

# --- API security ---
# API_KEY: khóa X-API-Key tùy chọn cho script/CI (đi vào với quyền admin "service").
# Để trống = tắt đường API key; KHÔNG có nghĩa là mở cửa — mọi API đều cần đăng nhập.
API_KEY=
# AUTH_SECRET_KEY: bí mật ký cookie phiên đăng nhập (bắt buộc để đăng nhập hoạt động).
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Đổi giá trị này = đăng xuất toàn bộ người dùng ngay lập tức.
AUTH_SECRET_KEY=
# Thời hạn phiên đăng nhập (giờ).
# AUTH_SESSION_TTL_HOURS=12
# Cookie phiên có cờ Secure (mặc định true; trình duyệt chỉ gửi qua https, riêng localhost vẫn được).
# Chỉ đặt false khi chạy http thuần ngoài localhost.
# AUTH_COOKIE_SECURE=true
# Sau reverse proxy, chạy uvicorn với --proxy-headers --forwarded-allow-ips=<IP proxy>,
# nếu không giới hạn đăng nhập theo IP sẽ tính chung mọi người vào IP của proxy.

# --- Azure AI Search (tùy chọn — xem docs/13-RAG-OBSERVABILITY-GUIDE.md) ---
# Bật khi đã tạo index trên Azure và chạy: python scripts/index_azure.py
# Hoặc tự động: python scripts/setup_azure_search.py --upload
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=knowledge-index

# --- Embeddings (semantic search pgvector) ---
#
# Cách 1 — OpenAI trực tiếp (ví dụ ada-002):
#   EMBEDDING_PROVIDER=openai
#   EMBEDDING_MODEL=text-embedding-ada-002
#   EMBEDDING_DIMENSIONS=1536
#   OPENAI_API_KEY=sk-...
#
# Cách 2 — OpenRouter:
#   EMBEDDING_PROVIDER=openrouter
#   EMBEDDING_MODEL=openai/text-embedding-ada-002
#   OPENROUTER_API_KEY=sk-or-...
#
# Cách 3 — Azure OpenAI:
#   EMBEDDING_PROVIDER=azure
#   EMBEDDING_DEPLOYMENT=text-embedding-ada-002
#   EMBEDDING_DIMENSIONS=1536
#   AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
#   AZURE_OPENAI_API_KEY=...
#
# EMBEDDING_PROVIDER=auto
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_DIMENSIONS=1536

# --- Chunking (tùy chỉnh khi upload file) ---
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120

# --- Search quality ---
# SEARCH_RERANK_ENABLED=true

# --- Eval LLM-as-judge (cần LLM provider) ---
# EVAL_LLM_JUDGE_ENABLED=true

# --- Web search (Tavily — optional, bật khi research/legal) ---
# Lấy key: https://tavily.com/
TAVILY_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_DEPTH=basic

# --- Feedback loop (P0) — docs/15-FEEDBACK-LOOP.md ---
# Mỗi /chat auto-save Q+A → platform.feedback (cần PLATFORM_DATABASE_URL)
# Rate: POST /api/v1/feedback {"trace_id":"...","rating":5}
# Export: python scripts/export_feedback.py -o data/train.jsonl

# --- P2: Langfuse tracing (optional) ---
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- P2: Auto-promote rated Q&A into RAG (0 = disabled) ---
# FEEDBACK_AUTO_PROMOTE_MIN_RATING=5
